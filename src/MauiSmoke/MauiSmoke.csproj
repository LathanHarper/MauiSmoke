<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MauiSmoke</RootNamespace>
    <AssemblyName>MauiSmoke</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiVersion>10.0.20</MauiVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <Authors>CodeCrafty.net</Authors>
    <Company>CodeCrafty.net</Company>
    <Copyright>Copyright © 2026 CodeCrafty.net</Copyright>
    <ApplicationTitle>MauiSmoke</ApplicationTitle>
    <ApplicationId>net.codecrafty.mauismoke</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">ios-arm64;iossimulator-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              ForegroundScale="0.62"
              Color="#071B2A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#071B2A"
                      BaseSize="128,128" />
    <MauiAsset Include="..\..\LICENSE"
               LogicalName="licenses/MauiSmoke-MIT.txt" />
    <MauiAsset Include="..\..\THIRD-PARTY-NOTICES.md"
               LogicalName="licenses/THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

</Project>
